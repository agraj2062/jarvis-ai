# Copy to .env and fill in. NEVER commit .env.

# --- Brain (any OpenAI-compatible endpoint) ---
# Local with Ollama (default):
JARVIS_BASE_URL=http://localhost:11434/v1
JARVIS_API_KEY=ollama
JARVIS_MODEL=qwen2.5:7b
# Hosted example:
# JARVIS_BASE_URL=https://api.openai.com/v1
# JARVIS_API_KEY=sk-...
# JARVIS_MODEL=gpt-4o-mini

# --- GitHub ---
# Create a FINE-GRAINED token at https://github.com/settings/personal-access-tokens
# Start with read-only scopes (Contents, Issues, Pull requests, Metadata: read).
GITHUB_TOKEN=

# --- Persona & voice (v0.2) ---
JARVIS_ADDRESS=sir
# JARVIS_VOICE_MODEL=voices/en_GB-alan-medium.onnx
# JARVIS_WHISPER_MODEL=base.en
# If it never hears you (or hears everything), tune this: lower = more sensitive
# JARVIS_MIC_LEVEL=500
